# Auto detect text files and normalize line endings to LF in the repository,
# checked out as the OS-appropriate ending (CRLF on Windows, LF elsewhere).
* text=auto eol=lf

# Explicit text types
*.cs text
*.csproj text
*.slnx text
*.json text
*.md text
*.ts text
*.tsx text
*.js text
*.jsx text
*.html text
*.css text
*.yml text
*.yaml text

# Windows-specific scripts should keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pfx binary
*.dll binary
*.exe binary
